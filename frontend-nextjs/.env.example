# ==============================================================================
# DECOFROG 3D - ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Copy this file to .env.local on your local machine and populate the values.
# Note: All production values are pre-configured on Vercel for decofrog3d.com.

# ------------------------------------------------------------------------------
# 1. Supabase Cloud Database Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://tviakpxdnomilnukbjtw.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ------------------------------------------------------------------------------
# 2. Payment Gateway Configuration
# ------------------------------------------------------------------------------
# Active gateway (razorpay | cashfree)
NEXT_PUBLIC_PAYMENT_GATEWAY=razorpay
NEXT_PUBLIC_APP_CURRENCY=INR

# Razorpay Keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Cashfree Keys
NEXT_PUBLIC_CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key
CASHFREE_ENVIRONMENT=PRODUCTION

# ------------------------------------------------------------------------------
# 3. Security Salt
# ------------------------------------------------------------------------------
SUBSCRIPTION_JWT_SECRET=your_jwt_secret_salt

# ------------------------------------------------------------------------------
# 4. Google OAuth 2.0 Social Login
# ------------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ------------------------------------------------------------------------------
# 5. Gmail SMTP Email Dispatch (OTP, Credentials, Password Reset)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM="DecoFrog 3D" <your_email@gmail.com>

# ------------------------------------------------------------------------------
# 6. Application Base URL
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://decofrog3d.com
