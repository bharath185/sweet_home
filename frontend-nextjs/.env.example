# Razorpay Payment Gateway Keys (Get from https://dashboard.razorpay.com/app/keys)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_YourRazorpayKeyId
RAZORPAY_KEY_SECRET=YourRazorpayKeySecret

# Application Currency
NEXT_PUBLIC_APP_CURRENCY=INR

# App Security Salt for Tamper-Proof Subscription Verification
SUBSCRIPTION_JWT_SECRET=sweethome_secure_subscription_salt_2026_prod
