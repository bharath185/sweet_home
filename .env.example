# PostgreSQL Database Settings
POSTGRES_DB=sweethome_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Spring Boot Backend Settings
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/sweethome_db
