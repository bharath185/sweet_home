<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <groupId>com.eteks</groupId>
    <artifactId>sweethome3d-springboot</artifactId>
    <version>1.0.0</version>
    <name>SweetHome3D Spring Boot Server</name>
    <description>Enterprise Spring Boot Web Server for Sweet Home 3D</description>

    <properties>
        <java.version>17</java.version>
    </properties>

    <dependencies>
        <!-- Spring Boot Web Starter -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- SweetHome3D Main Core JAR -->
        <dependency>
            <groupId>com.eteks</groupId>
            <artifactId>sweethome3d-core</artifactId>
            <version>5.4</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/libs/SweetHome3D.jar</systemPath>
        </dependency>

        <!-- Java 3D Vecmath -->
        <dependency>
            <groupId>javax.vecmath</groupId>
            <artifactId>vecmath</artifactId>
            <version>1.5.2</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/libs/vecmath.jar</systemPath>
        </dependency>

        <!-- Java 3D Core -->
        <dependency>
            <groupId>javax.media.j3d</groupId>
            <artifactId>j3dcore</artifactId>
            <version>1.5.2</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/libs/j3dcore.jar</systemPath>
        </dependency>

        <!-- Java 3D Utils -->
        <dependency>
            <groupId>javax.media.j3d</groupId>
            <artifactId>j3dutils</artifactId>
            <version>1.5.2</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/libs/j3dutils.jar</systemPath>
        </dependency>

        <!-- Sunflow Raytracer -->
        <dependency>
            <groupId>org.sunflow</groupId>
            <artifactId>sunflow</artifactId>
            <version>0.07.3i</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/libs/sunflow-0.07.3i.jar</systemPath>
        </dependency>

        <!-- iText PDF Generation -->
        <dependency>
            <groupId>com.lowagie</groupId>
            <artifactId>itext</artifactId>
            <version>2.1.7</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/libs/iText-2.1.7.jar</systemPath>
        </dependency>

        <!-- FreeHEP SVG Vector Graphics -->
        <dependency>
            <groupId>org.freehep</groupId>
            <artifactId>freehep-vectorgraphics-svg</artifactId>
            <version>2.1.1b</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/libs/freehep-vectorgraphics-svg-2.1.1b.jar</systemPath>
        </dependency>

        <!-- Batik SVG Path Parser -->
        <dependency>
            <groupId>org.apache.xmlgraphics</groupId>
            <artifactId>batik-svgpathparser</artifactId>
            <version>1.7</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/libs/batik-svgpathparser-1.7.jar</systemPath>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <includeSystemScope>true</includeSystemScope>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
